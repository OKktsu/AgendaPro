# Configuração usada pelo backend fora do Docker.
DATABASE_URL="postgresql://agendapro:agendapro@localhost:5432/agendapro?schema=public"
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET="agendapro-secret-key-change-in-production"
