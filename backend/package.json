{
  "name": "@agendapro/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker:dev": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "queue:probe": "tsx src/queue/enqueue.ts",
    "test:queue": "node test-support/run-queue-tests.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node test-support/run-multibase-tests.mjs",
    "db:lab:up": "docker compose -f ../docker-compose.multibase-test.yml -p agendapro-multibase-lab up -d",
    "db:lab:down": "docker compose -f ../docker-compose.multibase-test.yml -p agendapro-multibase-lab down",
    "db:generate": "prisma generate && prisma generate --schema prisma/accounts/schema.prisma && prisma generate --schema prisma/tenant/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:accounts": "prisma migrate deploy --schema prisma/accounts/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@prisma/client": "^6.6.0",
    "bullmq": "^6.3.11",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "google-auth-library": "^11.1.0",
    "ioredis": "^5.11.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.15.2",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vitest": "^3.1.1"
  }
}
