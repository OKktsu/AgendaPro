generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@agendapro/accounts-client"
}

datasource db {
  provider = "postgresql"
  url      = env("ACCOUNTS_DATABASE_URL")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  FAILED
  SUSPENDED
}

enum AccountRole {
  OWNER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model TenantDirectory {
  id          String       @id @db.Uuid
  databaseKey String       @unique
  status      TenantStatus @default(PROVISIONING)
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Account {
  id            String       @id @db.Uuid
  email         String       @unique
  passwordHash  String
  googleSubject String?      @unique
  memberships   Membership[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Membership {
  accountId String           @db.Uuid
  tenantId  String           @db.Uuid
  role      AccountRole      @default(STAFF)
  status    MembershipStatus @default(ACTIVE)
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant    TenantDirectory  @relation(fields: [tenantId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@id([accountId, tenantId])
  @@index([tenantId])
}
